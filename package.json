{
  "name": "deals-api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -e dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply deals-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply deals-db --remote"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.1",
    "ai": "^7.0.137",
    "hono": "^4.13.13",
    "stripe": "^23.0.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "wrangler": "^4.110.0"
  }
}
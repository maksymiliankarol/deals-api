{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "deals-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-13",
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "deals-api.metalogrom.com",
			"custom_domain": true
		}
	],
	"vars": {
		"WEB_URL": "https://deals.metalogrom.com"
	},
	"d1_databases": [
		{
			"binding": "deals_db",
			"database_name": "deals-db",
			"database_id": "db7c1f1d-bdc1-48d4-a559-f000f535b45b",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "VECTORIZE_BUY",
			"index_name": "buy-index-1536"
		}
	],
	"ratelimits": [
		{
			"name": "RL_BUY",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RL_SEARCH",
			"namespace_id": "1002",
			"simple": {
				"limit": 10,
				"period": 60
			}
		},
		{
			"name": "RL_UNLOCK",
			"namespace_id": "1003",
			"simple": {
				"limit": 5,
				"period": 60
			}
		},
		{
			"name": "RL_SESSION",
			"namespace_id": "1004",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	// Local development: `wrangler dev -e dev`.
	// Named environments inherit no bindings or vars, so all of them are repeated.
	"env": {
		"dev": {
			"vars": {
				"WEB_URL": "http://localhost:5173"
			},
			"d1_databases": [
				{
					"binding": "deals_db",
					"database_name": "deals-db",
					// Same id as production so existing local data keeps working.
					// Stays local-only unless --remote is passed.
					"database_id": "db7c1f1d-bdc1-48d4-a559-f000f535b45b",
					"migrations_dir": "migrations"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"vectorize": [
				{
					"binding": "VECTORIZE_BUY",
					"index_name": "buy-index-1536-dev",
					"remote": true
				}
			],
			"ratelimits": [
				{
					"name": "RL_BUY",
					"namespace_id": "2001",
					"simple": {
						"limit": 5,
						"period": 60
					}
				},
				{
					"name": "RL_SEARCH",
					"namespace_id": "2002",
					"simple": {
						"limit": 10,
						"period": 60
					}
				},
				{
					"name": "RL_UNLOCK",
					"namespace_id": "2003",
					"simple": {
						"limit": 5,
						"period": 60
					}
				},
				{
					"name": "RL_SESSION",
					"namespace_id": "2004",
					"simple": {
						"limit": 20,
						"period": 60
					}
				}
			]
		}
	}
}